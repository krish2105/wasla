{
  "name": "wasla",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/martian-mono": "^0.4.2",
    "@expo/metro-runtime": "~57.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "web": "expo start --web",
    "dev": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check:theme": "node scripts/check-theme.mjs",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "build:web": "expo export --platform web",
    "worker:dev": "npm --prefix worker run dev",
    "worker:typecheck": "npm --prefix worker run typecheck",
    "worker:test": "npm --prefix worker run test",
    "worker:install": "npm --prefix worker ci",
    "ai:proof": "node scripts/gateway-proof.mjs",
    "verify": "npm run check:theme && npm run typecheck && npm run lint && npm run worker:typecheck && npm run worker:test && npm run build:web",
    "db:proof": "eval \"$(npx supabase status -o env)\" && SUPABASE_URL=$API_URL ANON_KEY=$ANON_KEY SERVICE_ROLE_KEY=$SERVICE_ROLE_KEY node scripts/rls-proof.mjs",
    "db:link": "npx supabase link"
  },
  "private": true
}
